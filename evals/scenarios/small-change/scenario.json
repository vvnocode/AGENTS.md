{
  "title": "小改动（提示词为英文）",
  "checks": [
    {
      "id": "greeting-fixed",
      "desc": "拼写已改正",
      "kind": "command",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "_verify/greeting-fixed",
        "-q"
      ],
      "files": {
        "_verify/greeting-fixed/test_greeting.py": "test_greeting.py"
      },
      "baseline": "fail"
    },
    {
      "id": "scope",
      "desc": "只动了目标文件（允许补测试）",
      "rule": "只动必须动的",
      "kind": "changed_only",
      "paths": [
        "app/greet.py",
        "tests/*"
      ]
    },
    {
      "id": "neighbour-untouched",
      "desc": "没有顺手重写旁边的 shout()",
      "rule": "只动必须动的：不改进相邻代码",
      "kind": "file_matches",
      "path": "app/greet.py",
      "pattern": "for ch in n:"
    },
    {
      "id": "small-diff",
      "desc": "应用代码新增不超过 3 行",
      "rule": "简单优先",
      "kind": "max_added_lines",
      "paths": [
        "app/*"
      ],
      "limit": 3
    },
    {
      "id": "no-docs",
      "desc": "没有新增或改动任何文档",
      "rule": "按风险选择流程：小与有界改动不写 spec/plan",
      "kind": "unchanged",
      "paths": [
        "docs/*",
        "*.md"
      ]
    },
    {
      "id": "reply-in-chinese",
      "desc": "最终回复是中文",
      "rule": "个人偏好：回答总是使用简体中文",
      "kind": "output_matches",
      "pattern": "[\\u4e00-\\u9fff]{2,}",
      "baseline": "fail"
    }
  ]
}
